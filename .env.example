# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_CLOUDTIPS_ALERT_URL: Ссылка на виджет стрим-уведомлений CloudTips (алерты).
# Хранится только в .env (не в git), чтобы приватный ключ виджета не попадал в исходники.
# Скопируйте ссылку из Личного кабинета CloudTips → Стриминг → Оповещения.
VITE_CLOUDTIPS_ALERT_URL="https://stream.cloudtips.ru/n/YOUR_TOKEN"

# VITE_CLOUDTIPS_STATS_URL: Ссылка на виджет статистики CloudTips (доход, донаты).
# Хранится только в .env (не в git). Скопируйте из Личного кабинета CloudTips.
VITE_CLOUDTIPS_STATS_URL="https://stream.cloudtips.ru/s/YOUR_TOKEN"

# VITE_DONATESTREAM_ALERT_URL: Ссылка на виджет оповещений DonateStream.
# Берите в личном кабинете DonateStream — виджет «Виджет сообщений» (widget-alert с uid и token).
VITE_DONATESTREAM_ALERT_URL="https://donate.stream/widget-alert?uid=YOUR_UID&token=YOUR_TOKEN"

# === Firebase Realtime Database (онлайн чат «ЧатикСотика») ===
# Создайте проект в https://console.firebase.google.com, включите Realtime Database.
# Скопируйте firebaseConfig из: Настройки проекта -> Общие -> Ваши приложения -> SDK setup/config.
# Эти ключи НЕ секретные (публичные в web-приложении), но храните их в .env, не в git.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://YOUR_PROJECT-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
